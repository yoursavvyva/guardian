# ── Guardian Phase 1 config ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# Schedule (America/New_York). Times are 24h HH:MM, comma-separated.
GUARDIAN_TIMEZONE=America/New_York
GUARDIAN_SCHEDULE=11:00,16:00,20:30
GUARDIAN_RETRY_MINUTES=20
GUARDIAN_MAX_ATTEMPTS=3

# API (internal only — PMC consumes these endpoints, bound to 127.0.0.1)
GUARDIAN_PORT=8101
GUARDIAN_API_TOKEN=change-me-to-a-long-random-string

# Telegram alerts (Bot API). Create a bot via @BotFather, get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Call provider: mock | telnyx | 3cx  (KEEP mock until you're ready for real calls)
CALL_PROVIDER=mock
# mock outcome for scheduled checks: answered | missed | failed | random
GUARDIAN_MOCK_RESULT=answered

# Call targets
MOM_3CX_EXTENSION=
MOM_CELL_PHONE=

# Telnyx Programmable Voice (Phase 2 — leave blank for mock)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_WEBHOOK_SECRET=

# 3CX Call Control (Phase 2 — leave blank for mock)
THREECX_BASE_URL=
THREECX_CLIENT_ID=
THREECX_CLIENT_SECRET=
THREECX_EXTENSION=
