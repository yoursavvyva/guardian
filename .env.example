# ── Guardian Phase 1 config ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# Schedule (America/New_York). Times are 24h HH:MM, comma-separated.
# Pilot = two daily checks: 11:00 AM + 6:00 PM. Leave EMPTY to disable the scheduler.
GUARDIAN_TIMEZONE=America/New_York
GUARDIAN_SCHEDULE=11:00,18:00
GUARDIAN_RETRY_MINUTES=20
GUARDIAN_MAX_ATTEMPTS=3

# API (internal only — PMC consumes these endpoints, bound to 127.0.0.1)
GUARDIAN_PORT=8101
GUARDIAN_API_TOKEN=change-me-to-a-long-random-string

# Telegram alerts (Bot API). Create a bot via @BotFather, get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Call provider: mock | telnyx | 3cx  (KEEP mock until you're ready for real calls)
#   3cx = place real calls through the shared Claude-Phone voice-app as Angel.
CALL_PROVIDER=mock
# mock outcome for scheduled checks: confirmed_ok | needs_darcee | answered_unconfirmed | missed | failed | random
# (legacy alias: "answered" == confirmed_ok)
GUARDIAN_MOCK_RESULT=answered

# Voice-app outbound API (3cx provider). Angel must exist in voice-app devices.json.
VOICE_APP_URL=http://127.0.0.1:3030
ANGEL_DEVICE=Angel
GUARDIAN_RING_SECONDS=30

# ANGEL-05 — two-choice wellness menu (DTMF only; no speech recognition, no open-ended Q&A).
#   press 1 = okay (confirmed_ok)   press 2 = have Darcee call me (needs_darcee)
GUARDIAN_CALL_MESSAGE=Hi Mom, this is Angel checking in. Are you okay today? Press 1 for yes. Press 2 if you need Darcee to call you.
GUARDIAN_CALL_REPROMPT=I didn't receive your answer. Press 1 if you are okay. Press 2 if you need Darcee to call you.
GUARDIAN_OKAY_DIGIT=1
GUARDIAN_NEEDS_CALL_DIGIT=2
# Audible acknowledgment spoken for the pressed key, just before hangup.
GUARDIAN_ACK_OKAY=Thank you, Mom. I'm glad you're okay. Have a wonderful day.
GUARDIAN_ACK_NEEDS_CALL=Thank you, Mom. I'll let Darcee know you'd like a call. Talk to you later.

# ── Trash-day rider ────────────────────────────────────────────────────────
# A SECOND DTMF question asked in the same call, only on the configured day+time
# check (e.g. the Monday 12:00 PM check asks if the trash goes out Tuesday).
# A "yes" (press 1) alerts Darcee (TELEGRAM_CHAT_ID) + GUARDIAN_TRASH_CHAT_IDS.
GUARDIAN_TRASH_ENABLED=true
GUARDIAN_TRASH_DAY=Monday
GUARDIAN_TRASH_TIME=12:00
GUARDIAN_TRASH_MESSAGE=One more thing, Mom. Does the trash need to go out tomorrow? Press 1 for yes. Press 2 for no.
GUARDIAN_TRASH_REPROMPT=I didn't catch that. If the trash needs to go out tomorrow, press 1. If not, press 2.
GUARDIAN_TRASH_YES_DIGIT=1
GUARDIAN_TRASH_NO_DIGIT=2
GUARDIAN_TRASH_ACK_YES=Thank you, Mom. I'll let Darcee know the trash needs to go out tomorrow.
GUARDIAN_TRASH_ACK_NO=Okay, Mom. No trash tomorrow. Thank you.
# Extra Telegram chat IDs to alert on "yes" (besides Darcee) — e.g. the sister who
# takes the trash out. Comma-separated. Empty = Darcee only.
GUARDIAN_TRASH_CHAT_IDS=

# Call targets
MOM_3CX_EXTENSION=
MOM_CELL_PHONE=

# Telnyx Programmable Voice (Phase 2 — leave blank for mock)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_WEBHOOK_SECRET=

# 3CX (Phase 2 — leave blank while CALL_PROVIDER=mock)
# Angel's OWN extension SIP credentials — the line Guardian calls FROM.
# (Mom's ext is only a destination = MOM_3CX_EXTENSION; her SIP creds are NEVER needed.)
THREECX_EXTENSION=        # Angel's extension number
THREECX_AUTH_ID=          # Angel's SIP Authentication ID
THREECX_PASSWORD=         # Angel's SIP password
THREECX_SIP_DOMAIN=       # e.g. 1750.3cx.cloud
THREECX_SIP_PORT=5060
THREECX_OUTBOUND_PROXY=   # local 3CX SBC address (the path Angel sends SIP through)
# Optional: 3CX Call Control API (alternative to SIP registration)
THREECX_BASE_URL=
THREECX_CLIENT_ID=
THREECX_CLIENT_SECRET=

# ---- ANGEL-09b: direct Alexa custom-endpoint (replaces the Alexa-hosted Lambda) ----
# The skill's applicationId (amzn1.ask.skill.xxxx). When set, /guardian/alexa/skill ONLY
# accepts requests carrying this id — the auth boundary for the public endpoint (Alexa
# cannot send our shared token). Get it from the Alexa dev console after creating the
# "Provision your own" skill. Leave empty only for pre-skill testing.
GUARDIAN_ALEXA_SKILL_ID=
